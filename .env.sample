VITE_SENTRY_DSN=
# OPTIONAL fraction of transactions traced by Sentry, defaults to 0.5
VITE_SENTRY_TRACES_SAMPLE_RATE=0.5
# OPTIONAL site name and title, default to Journal
VITE_APP_NAME=Journal
VITE_APP_TITLE=Journal
# OPTIONAL ENV variable, will default to development if none is set
VITE_ENV=development
# OPTIONAL firebase settings
VITE_FIREBASE_API_KEY=<FIREBASE_APIKEY>
VITE_FIREBASE_AUTH_DOMAIN=<FIREBASE_AUTH_DOMAIN>
VITE_FIREBASE_PROJECT_ID=<FIREBASE_PROJECT_ID>
VITE_FIREBASE_STORAGE_BUCKET=<FIREBASE_STORAGE_BUCKET>
VITE_FIREBASE_MESSAGING_SENDER_ID=<FIREBASE_MESSAGING_SENDER_ID>
VITE_FIREBASE_APP_ID=<FIREBASE_APP_ID>
VITE_FIREBASE_MEASUREMENT_ID=<FIREBASE_MEASUREMENT_ID>
# contentful cms settings
VITE_CONTENTFUL_CMS_SPACE_ID=<CONTENTFUL_CMS_SPACE_ID>
VITE_CONTENTFUL_CMS_GRAPHQL_URL=<CONTENTFUL_CMS_GRAPHQL_URL>
VITE_CONTENTFUL_CMS_API_KEY=<CONTENTFUL_CMS_API_KEY>
VITE_CONTENTFUL_CMS_REST_API_URL=<CONTENTFUL_CMS_REST_API_URL>
VITE_CONTENTFUL_CMS_PREVIEW_REST_API_URL=<CONTENTFUL_CMS_PREVIEW_REST_API_URL>
VITE_CONTENTFUL_CMS_ENVIRONMENT=<CONTENTFUL_CMS_ENVIRONMENT>
VITE_CONTENTFUL_CMS_PREVIEW=<CONTENTFUL_CMS_PREVIEW>
# server-only Notion settings (do not prefix with VITE_)
NOTION_API_KEY=<NOTION_API_KEY>
# Set one of the two. The data source ID is preferred; copy it from the database's data source settings in Notion (it is not the ID in the database URL).
# With only the database ID, its first data source is looked up at runtime.
NOTION_DATA_SOURCE_ID=<NOTION_DATA_SOURCE_ID>
# Alternative to NOTION_DATA_SOURCE_ID; its first data source is used.
NOTION_DATABASE_ID=
