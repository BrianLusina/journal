{
  "files": [],
  "references": [{ "path": "./tsconfig.app.json" }, { "path": "./tsconfig.node.json" }],
  "compilerOptions": {
    "baseUrl": ".",
    "target": "es6",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "noImplicitAny": false,
    "noUnusedParameters": false,
    "noUnusedLocals": false,
    "strictNullChecks": false,
    "paths": {
      "@/*": ["./src/*"],
      "@assets/*": ["./src/assets/*"],
      "@icons/*": ["./src/assets/icons/*"],
      "@images/*": ["./src/assets/images/*"],
      "@fonts/*": ["./src/assets/fonts/*"],
      "@app": ["./src/app/index.ts"],
      "@config": ["./src/config/index.ts"],
      "@apiConfig": ["./src/config/api.ts"],
      "@routes": ["./src/config/routes.ts"],
      "@graphQl/*": ["./src/api/graphql/*"],
      "@graphQlClient": ["./src/api/graphql/GraphqlClient.ts"],
      "@providers/*": ["./src/providers/*"],
      "@components/*": ["./src/components/*"],
      "@containers/*": ["./src/containers/*"],
      "@features/*": ["./src/features/*"],
      "@pages/*": ["./src/pages/*"],
      "@layouts/*": ["./src/layouts/*"],
      "@utils": ["./src/utils/utils.ts"],
      "@timeUtils": ["./src/utils/time/timeUtils.ts"],
      "@timeConstants": ["./src/utils/time/constants.ts"],
      "@hooks/*": ["./src/hooks/*"],
      "@services/*": ["./src/services/*"],
      "@monitoring": ["./src/services/monitoring/index.ts"],
      "@analytics": ["./src/services/analytics/index.ts"],
      "@testUtils/*": ["./src/test/*"],
      "@styles/*": ["./src/styles/*"],
      "@scss/*": ["./src/styles/scss/*"],
      "@css/*": ["./src/styles/css/*"],
      "@lib": ["./src/lib/index.ts"],
      "@lib/*": ["./src/lib/*"]
    }
  },
  "exclude": [
    "src/**/*.story.mdx",
    "src/**/*.story.@(js|jsx|ts|tsx)",
    "src/**/*.stories.mdx",
    "src/**/*.stories.@(js|jsx|ts|tsx)"
  ]
}