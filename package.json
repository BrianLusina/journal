{
  "name": "brianlusina-sites",
  "private": true,
  "description": "Brian Lusina's personal sites: the blog today, brianlusina.com and folio next (#924).",
  "author": "Brian Lusina <12752833+BrianLusina@users.noreply.github.com>",
  "license": "The MIT License (MIT)",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "vercel:dev": "bun run --filter blog vercel:dev",
    "dev": "bun run --filter blog dev",
    "build": "bun run --filter blog build",
    "build:dev": "bun run --filter blog build:dev",
    "check:bundle-size": "bun run --filter blog check:bundle-size",
    "preview": "bun run --filter blog preview",
    "lint": "bun run --filter blog lint",
    "lint:styles": "bun run --filter blog lint:styles",
    "lint:styles:fix": "bun run --filter blog lint:styles:fix",
    "lint:fix": "bun run --filter blog lint:fix",
    "typecheck": "bun run --filter blog typecheck",
    "typecheck:api": "bun run --filter blog typecheck:api",
    "typecheck:server": "bun run --filter blog typecheck:server",
    "format": "bun run --filter blog format",
    "test": "bun run --filter blog test",
    "test:watch": "bun run --filter blog test:watch",
    "test:coverage": "bun run --filter blog test:coverage",
    "clean": "bun run --filter blog clean",
    "depcheck": "bun run --filter blog depcheck",
    "scan:licenses": "bun run --filter blog scan:licenses",
    "storybook:dev": "bun run --filter blog storybook:dev",
    "storybook:build": "bun run --filter blog storybook:build",
    "prepare": "husky install",
    "pre-commit": "lint-staged",
    "e2e": "playwright test",
    "e2e:record": "E2E_RECORD=1 playwright test --project=blog --grep @record",
    "typecheck:e2e": "tsc -p e2e/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@commitlint/cli": "^12.1.4",
    "@commitlint/config-conventional": "^12.1.4",
    "husky": "^6.0.0",
    "lint-staged": "^11.0.0",
    "danger": "^10.7.1",
    "imagemin-lint-staged": "^0.4.0",
    "@playwright/test": "1.65.0",
    "@axe-core/playwright": "4.14.0"
  }
}
