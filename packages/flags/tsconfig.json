{
  // CommonJS with Node resolution, like packages/cms: the blog and apps/sites both import this, and
  // neither may need an ES-only module (see packages/cms/dependencies.spec.ts).
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022"],
    "types": ["node", "vitest/globals"],
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "coverage"]
}
