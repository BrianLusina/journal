{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitAny": false,
    "noFallthroughCasesInSwitch": false,
    "paths": {
      "@/*": ["./src/*"],
      "@assets/*": ["./src/assets/*"],
      "@icons/*": ["./src/assets/icons/*"],
      "@images/*": ["./src/assets/images/*"],
      "@fonts/*": ["./src/assets/fonts/*"],
      "@app": ["./src/app/index.ts"],
      "@config": ["./src/config/index.ts"],
      "@apiConfig": ["./src/config/api.ts"],
      "@routes": ["./src/config/routes.ts"],
      "@graphQl/*": ["./src/clients/graphql/*"],
      "@graphQlClient": ["./src/clients/graphql/GraphQlClient.ts"],
      "@graphQlQueries": ["./src/clients/graphql/queries/index.ts"],
      "@contentfulClient": ["./src/integrations/contentful/index.ts"],
      "@providers/*": ["./src/providers/*"],
      "@components": ["./src/components/index.ts"],
      "@containers/*": ["./src/containers/*"],
      "@features": ["./src/features/index.ts"],
      "@pages/*": ["./src/pages/*"],
      "@layouts/*": ["./src/layouts/*"],
      "@utils": ["./src/utils/utils.ts"],
      "@timeUtils": ["./src/utils/time/timeUtils.ts"],
      "@timeConstants": ["./src/utils/time/constants.ts"],
      "@hooks": ["./src/hooks/index.ts"],
      "@analyticsHooks": ["./src/hooks/analytics/index.ts"],
      "@apiHooks": ["./src/hooks/api/index.ts"],
      "@cmsHooks": ["./src/hooks/cms/index.ts"],
      "@utilsHooks": ["./src/hooks/utils/index.ts"],      
      "@services": ["./src/services/index.ts"],
      "@monitoring": ["./src/services/monitoring/index.ts"],
      "@analytics": ["./src/services/analytics/index.ts"],
      "@cmsService": ["./src/services/cms/index.ts"],
      "@firebaseClient": ["./src/services/firebase/index.ts"],
      "@testUtils/*": ["./src/test/*"],
      "@styles/*": ["./src/styles/*"],
      "@styled/*": ["./src/styles/ts/*"],
      "@scss/*": ["./src/styles/scss/*"],
      "@css/*": ["./src/styles/css/*"]      
    }
  },
  "include": ["src"]
}
